import {
  BadRequestException,
  Inject,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service.js';
import { UaeEinvoiceReadinessService } from '../compliance/readiness/uae-einvoice-readiness.service.js';
import { UaePintAeUblService } from '../compliance/ubl/uae-pint-ae-ubl.service.js';
import type {
  AspAdapter,
  AspSubmissionRequest,
} from './contracts/asp-adapter.interface.js';
import { ASP_ADAPTER } from './contracts/asp.tokens.js';

@Injectable()
export class AspService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly readinessService: UaeEinvoiceReadinessService,
    private readonly ublService: UaePintAeUblService,
    @Inject(ASP_ADAPTER)
    private readonly adapter: AspAdapter,
  ) {}

  async submit(
    invoiceId: string,
    tenantId: string,
    userId?: string,
  ) {
    const invoice = await this.prisma.invoice.findFirst({
      where: {
        id: invoiceId,
        tenantId,
      },
      select: {
        id: true,
        invoiceNumber: true,
        invoiceTypeCode: true,
      },
    });

    if (!invoice) {
      throw new NotFoundException(
        'Invoice not found for authenticated tenant.',
      );
    }

    const readiness = await this.readinessService.evaluate(
      invoiceId,
      tenantId,
      userId,
    );

    if (readiness.readinessStatus !== 'READY') {
      throw new BadRequestException({
        message:
          'Document is not READY and cannot be submitted to an ASP.',
        invoiceId,
        readinessStatus: readiness.readinessStatus,
        internalPassed: readiness.internal.passed,
        officialPassed: readiness.official.passed,
      });
    }

    const documentType =
      invoice.invoiceTypeCode === '381'
        ? 'CREDIT_NOTE'
        : invoice.invoiceTypeCode === '380'
          ? 'INVOICE'
          : null;

    if (!documentType) {
      throw new BadRequestException(
        `Unsupported document type for ASP submission: ${invoice.invoiceTypeCode ?? 'MISSING'}`,
      );
    }

    const ublXml = await this.ublService.generate(
      invoiceId,
      tenantId,
    );

    const request: AspSubmissionRequest = {
      invoiceId,
      tenantId,
      documentType,
      documentNumber: invoice.invoiceNumber,
      ublXml,
    };

    const result = await this.adapter.submit(request);

    return {
      invoiceId,
      documentNumber: invoice.invoiceNumber,
      documentType,
      readinessStatus: readiness.readinessStatus,
      provider: result.provider,
      submission: result,
    };
  }
}
