import {
  BadRequestException,
  Inject,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { createHash } from 'node:crypto';
import { Prisma } from '@prisma/client';
import { PrismaService } from '../prisma/prisma.service.js';
import { UaeEinvoiceReadinessService } from '../compliance/readiness/uae-einvoice-readiness.service.js';
import { UaePintAeUblService } from '../compliance/ubl/uae-pint-ae-ubl.service.js';
import type {
  AspAdapter,
  AspSubmissionRequest,
} from './contracts/asp-adapter.interface.js';
import { ASP_ADAPTER } from './contracts/asp.tokens.js';

@Injectable()
export class AspService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly readinessService: UaeEinvoiceReadinessService,
    private readonly ublService: UaePintAeUblService,
    @Inject(ASP_ADAPTER)
    private readonly adapter: AspAdapter,
  ) {}

  async listForInvoice(invoiceId: string, tenantId: string) {
    if (!tenantId) {
      throw new BadRequestException(
        'Authenticated tenant information is required',
      );
    }

    const invoice = await this.prisma.invoice.findFirst({
      where: { id: invoiceId, tenantId },
      select: { id: true },
    });

    if (!invoice) {
      throw new NotFoundException(
        'Invoice not found for authenticated tenant.',
      );
    }

    const submissions = await this.prisma.aspSubmission.findMany({
      where: { invoiceId, tenantId },
      orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
      select: {
        id: true,
        provider: true,
        status: true,
        providerReference: true,
        attemptCount: true,
        createdAt: true,
        submittedAt: true,
        completedAt: true,
        attempts: {
          orderBy: { attemptNumber: 'asc' },
          select: {
            id: true,
            attemptNumber: true,
            status: true,
            startedAt: true,
            completedAt: true,
          },
        },
      },
    });

    return { invoiceId, submissions };
  }

  async reconcile(
    submissionId: string,
    tenantId: string,
  ) {
    if (!tenantId) {
      throw new BadRequestException(
        'Authenticated tenant information is required',
      );
    }

    const submission =
      await this.prisma.aspSubmission.findFirst({
        where: {
          id: submissionId,
          tenantId,
        },
      });

    if (!submission) {
      throw new NotFoundException(
        'ASP submission not found for authenticated tenant.',
      );
    }

    if (
      submission.status !== 'UNKNOWN' &&
      submission.status !== 'PENDING'
    ) {
      throw new BadRequestException({
        message:
          'Only UNKNOWN or PENDING ASP submissions can be reconciled.',
        submissionId,
        status: submission.status,
      });
    }

    if (submission.provider !== this.adapter.providerName) {
      throw new BadRequestException({
        message:
          'The configured ASP adapter does not match this submission provider.',
        submissionId,
        submissionProvider: submission.provider,
        configuredProvider: this.adapter.providerName,
      });
    }

    const result =
      await this.adapter.getSubmissionStatus({
        invoiceId: submission.invoiceId,
        tenantId,
        documentNumber: submission.documentNumber,
        idempotencyKey: submission.idempotencyKey,
        providerReference:
          submission.providerReference ?? undefined,
      });

    const checkedAt = new Date();

    const terminal =
      result.status === 'ACCEPTED' ||
      result.status === 'REJECTED' ||
      result.status === 'ERROR';

    let updated;

    try {
      updated = await this.prisma.$transaction(
        async (tx) => {
          const latestAttempt =
            await tx.aspSubmissionAttempt.findFirst({
              where: {
                submissionId: submission.id,
              },
              orderBy: {
                attemptNumber: 'desc',
              },
            });

          const claim =
            await tx.aspSubmission.updateMany({
              where: {
                id: submission.id,
                tenantId,
                status: submission.status,
                attemptCount:
                  submission.attemptCount,
              },
              data: {
                status: result.status,
                providerReference:
                  result.providerReference ??
                  submission.providerReference,
                lastError:
                  result.status === 'UNKNOWN'
                    ? submission.lastError
                    : null,
                completedAt:
                  terminal ? checkedAt : null,
                acceptedAt:
                  result.status === 'ACCEPTED'
                    ? checkedAt
                    : submission.acceptedAt,
                rejectedAt:
                  result.status === 'REJECTED'
                    ? checkedAt
                    : submission.rejectedAt,
              },
            });

          if (claim.count !== 1) {
            throw new Error(
              'ASP_RECONCILIATION_CONCURRENT_STATE_CHANGE',
            );
          }

          if (latestAttempt) {
            const attemptUpdate =
              await tx.aspSubmissionAttempt.updateMany({
                where: {
                  id: latestAttempt.id,
                  submissionId: submission.id,
                  attemptNumber:
                    latestAttempt.attemptNumber,
                  status: latestAttempt.status,
                },
                data: {
                  status: result.status,
                  providerReference:
                    result.providerReference ??
                    latestAttempt.providerReference,
                  message:
                    result.message ??
                    latestAttempt.message,
                  errorCode:
                    result.status === 'UNKNOWN'
                      ? latestAttempt.errorCode
                      : null,
                  errorMessage:
                    result.status === 'UNKNOWN'
                      ? latestAttempt.errorMessage
                      : null,
                  completedAt:
                    terminal
                      ? checkedAt
                      : latestAttempt.completedAt,
                },
              });

            if (attemptUpdate.count !== 1) {
              throw new Error(
                'ASP_RECONCILIATION_CONCURRENT_STATE_CHANGE',
              );
            }
          }

          const persisted =
            await tx.aspSubmission.findUnique({
              where: {
                id: submission.id,
              },
            });

          if (!persisted) {
            throw new Error(
              'ASP_RECONCILIATION_SUBMISSION_DISAPPEARED',
            );
          }

          return persisted;
        },
      );
    } catch (error) {
      if (
        error instanceof Error &&
        error.message ===
          'ASP_RECONCILIATION_CONCURRENT_STATE_CHANGE'
      ) {
        throw new BadRequestException({
          message:
            'ASP submission state changed while reconciliation was in progress. The stale reconciliation result was not applied.',
          submissionId,
          previousStatus: submission.status,
        });
      }

      throw error;
    }

    return {
      submissionId: updated.id,
      invoiceId: updated.invoiceId,
      provider: updated.provider,
      previousStatus: submission.status,
      status: updated.status,
      reconciledAt: checkedAt,
      providerResult: result,
      submission: updated,
    };
  }
  async retry(
    submissionId: string,
    tenantId: string,
    userId?: string,
  ) {
    if (!tenantId) {
      throw new BadRequestException(
        'Authenticated tenant information is required',
      );
    }

    const submission =
      await this.prisma.aspSubmission.findFirst({
        where: {
          id: submissionId,
          tenantId,
        },
      });

    if (!submission) {
      throw new NotFoundException(
        'ASP submission not found for authenticated tenant.',
      );
    }

    if (
      submission.status !== 'REJECTED' &&
      submission.status !== 'ERROR'
    ) {
      throw new BadRequestException({
        message:
          'Only REJECTED or ERROR ASP submissions can be retried.',
        submissionId,
        status: submission.status,
      });
    }

    if (submission.provider !== this.adapter.providerName) {
      throw new BadRequestException({
        message:
          'The configured ASP adapter does not match this submission provider.',
        submissionId,
        submissionProvider: submission.provider,
        configuredProvider: this.adapter.providerName,
      });
    }

    const readiness = await this.readinessService.evaluate(
      submission.invoiceId,
      tenantId,
      userId,
    );

    if (readiness.readinessStatus !== 'READY') {
      throw new BadRequestException({
        message:
          'Document is not READY and cannot be retried to an ASP.',
        invoiceId: submission.invoiceId,
        submissionId,
        readinessStatus: readiness.readinessStatus,
        internalPassed: readiness.internal.passed,
        officialPassed: readiness.official.passed,
      });
    }

    const documentType =
      submission.documentType === 'CREDIT_NOTE'
        ? 'CREDIT_NOTE'
        : submission.documentType === 'INVOICE'
          ? 'INVOICE'
          : null;

    if (!documentType) {
      throw new BadRequestException(
        `Unsupported document type for ASP retry: ${submission.documentType}`,
      );
    }

    const ublXml = await this.ublService.generate(
      submission.invoiceId,
      tenantId,
    );

    const nextAttemptNumber =
      submission.attemptCount + 1;

    const claimedAt = new Date();

    let attempt;

    try {
      attempt = await this.prisma.$transaction(
        async (tx) => {
          const claim =
            await tx.aspSubmission.updateMany({
              where: {
                id: submission.id,
                tenantId,
                status: submission.status,
                attemptCount:
                  submission.attemptCount,
              },
              data: {
                status: 'SUBMITTING',
                attemptCount:
                  nextAttemptNumber,
                submittedAt: claimedAt,
                completedAt: null,
                acceptedAt: null,
                rejectedAt: null,
                lastError: null,
              },
            });

          if (claim.count !== 1) {
            throw new Error(
              'ASP_RETRY_CONCURRENT_CLAIM_FAILED',
            );
          }

          return tx.aspSubmissionAttempt.create({
            data: {
              submissionId: submission.id,
              attemptNumber:
                nextAttemptNumber,
              status: 'SUBMITTING',
            },
          });
        },
      );
    } catch (error) {
      if (
        error instanceof Error &&
        error.message ===
          'ASP_RETRY_CONCURRENT_CLAIM_FAILED'
      ) {
        throw new BadRequestException({
          message:
            'This ASP submission has already been claimed for retry or its state changed concurrently.',
          submissionId,
          attemptNumber:
            nextAttemptNumber,
        });
      }

      if (
        error instanceof Prisma.PrismaClientKnownRequestError &&
        error.code === 'P2002'
      ) {
        throw new BadRequestException({
          message:
            'A retry attempt for this submission is already in progress or has already been created.',
          submissionId,
          attemptNumber:
            nextAttemptNumber,
        });
      }

      throw error;
    }

    const request: AspSubmissionRequest = {
      invoiceId: submission.invoiceId,
      tenantId,
      documentType,
      documentNumber: submission.documentNumber,
      ublXml,
      idempotencyKey: submission.idempotencyKey,
    };

    try {
      const result =
        await this.adapter.submit(request);

      const completedAt = new Date();

      await this.prisma.$transaction([
        this.prisma.aspSubmissionAttempt.update({
          where: {
            id: attempt.id,
          },
          data: {
            status: result.status,
            providerReference:
              result.providerReference ?? null,
            message: result.message ?? null,
            completedAt:
              result.status === 'PENDING'
                ? null
                : completedAt,
          },
        }),

        this.prisma.aspSubmission.update({
          where: {
            id: submission.id,
          },
          data: {
            status: result.status,
            providerReference:
              result.providerReference ??
              submission.providerReference,
            completedAt:
              result.status === 'PENDING'
                ? null
                : completedAt,
            acceptedAt:
              result.status === 'ACCEPTED'
                ? completedAt
                : null,
            rejectedAt:
              result.status === 'REJECTED'
                ? completedAt
                : null,
            lastError: null,
          },
        }),
      ]);

      const persistedSubmission =
        await this.prisma.aspSubmission.findUnique({
          where: {
            id: submission.id,
          },
        });

      return {
        submissionId: submission.id,
        invoiceId: submission.invoiceId,
        provider: result.provider,
        previousStatus: submission.status,
        status: result.status,
        attemptNumber: nextAttemptNumber,
        submission: persistedSubmission,
        providerResult: result,
      };
    } catch (error) {
      const completedAt = new Date();

      const errorMessage =
        error instanceof Error
          ? error.message
          : 'Unknown ASP retry error';

      await this.prisma.$transaction([
        this.prisma.aspSubmissionAttempt.update({
          where: {
            id: attempt.id,
          },
          data: {
            status: 'UNKNOWN',
            errorCode: 'ASP_RESPONSE_UNKNOWN',
            errorMessage,
            completedAt,
          },
        }),

        this.prisma.aspSubmission.update({
          where: {
            id: submission.id,
          },
          data: {
            status: 'UNKNOWN',
            lastError: errorMessage,
            completedAt,
          },
        }),
      ]);

      throw new BadRequestException({
        message:
          'ASP retry outcome is unknown. Further retry is blocked pending reconciliation.',
        invoiceId: submission.invoiceId,
        submissionId: submission.id,
        attemptNumber: nextAttemptNumber,
        status: 'UNKNOWN',
      });
    }
  }
  async submit(
    invoiceId: string,
    tenantId: string,
    userId?: string,
  ) {
    const invoice = await this.prisma.invoice.findFirst({
      where: {
        id: invoiceId,
        tenantId,
      },
      select: {
        id: true,
        invoiceNumber: true,
        invoiceTypeCode: true,
      },
    });

    if (!invoice) {
      throw new NotFoundException(
        'Invoice not found for authenticated tenant.',
      );
    }

    const readiness = await this.readinessService.evaluate(
      invoiceId,
      tenantId,
      userId,
    );

    if (readiness.readinessStatus !== 'READY') {
      throw new BadRequestException({
        message:
          'Document is not READY and cannot be submitted to an ASP.',
        invoiceId,
        readinessStatus: readiness.readinessStatus,
        internalPassed: readiness.internal.passed,
        officialPassed: readiness.official.passed,
      });
    }

    const documentType =
      invoice.invoiceTypeCode === '381'
        ? 'CREDIT_NOTE'
        : invoice.invoiceTypeCode === '380'
          ? 'INVOICE'
          : null;

    if (!documentType) {
      throw new BadRequestException(
        `Unsupported document type for ASP submission: ${invoice.invoiceTypeCode ?? 'MISSING'}`,
      );
    }

    const ublXml = await this.ublService.generate(
      invoiceId,
      tenantId,
    );

    const documentFingerprint = createHash('sha256')
      .update(ublXml, 'utf8')
      .digest('hex');

    const idempotencyKey = createHash('sha256')
      .update(
        [
          tenantId,
          invoiceId,
          this.adapter.providerName,
          documentFingerprint,
        ].join(':'),
        'utf8',
      )
      .digest('hex');

    let persistentSubmission;
    let ownsSubmission = false;

    try {
      persistentSubmission =
        await this.prisma.aspSubmission.create({
          data: {
            invoiceId,
            tenantId,
            provider: this.adapter.providerName,
            documentType,
            documentNumber: invoice.invoiceNumber,
            status: 'CREATED',
            idempotencyKey,
          },
        });

      ownsSubmission = true;
    } catch (error) {
      if (
        error instanceof Prisma.PrismaClientKnownRequestError &&
        error.code === 'P2002'
      ) {
        persistentSubmission =
          await this.prisma.aspSubmission.findUnique({
            where: {
              idempotencyKey,
            },
          });

        if (!persistentSubmission) {
          throw error;
        }
      } else {
        throw error;
      }
    }

    if (!ownsSubmission) {
      return {
        invoiceId,
        documentNumber: invoice.invoiceNumber,
        documentType,
        readinessStatus: readiness.readinessStatus,
        provider: persistentSubmission.provider,
        duplicate: true,
        submission: persistentSubmission,
      };
    }

    const attempt =
      await this.prisma.aspSubmissionAttempt.create({
        data: {
          submissionId: persistentSubmission.id,
          attemptNumber: 1,
          status: 'SUBMITTING',
        },
      });

    await this.prisma.aspSubmission.update({
      where: {
        id: persistentSubmission.id,
      },
      data: {
        status: 'SUBMITTING',
        attemptCount: 1,
        submittedAt: new Date(),
      },
    });

    const request: AspSubmissionRequest = {
      invoiceId,
      tenantId,
      documentType,
      documentNumber: invoice.invoiceNumber,
      ublXml,
      idempotencyKey,
    };

    try {
      const result =
        await this.adapter.submit(request);

      const completedAt = new Date();

      await this.prisma.aspSubmissionAttempt.update({
        where: {
          id: attempt.id,
        },
        data: {
          status: result.status,
          providerReference:
            result.providerReference ?? null,
          message: result.message ?? null,
          completedAt:
            result.status === 'PENDING'
              ? null
              : completedAt,
        },
      });

      const persistedResult =
        await this.prisma.aspSubmission.update({
          where: {
            id: persistentSubmission.id,
          },
          data: {
            status: result.status,
            providerReference:
              result.providerReference ?? null,
            completedAt:
              result.status === 'PENDING'
                ? null
                : completedAt,
            acceptedAt:
              result.status === 'ACCEPTED'
                ? completedAt
                : null,
            rejectedAt:
              result.status === 'REJECTED'
                ? completedAt
                : null,
          },
        });

      return {
        invoiceId,
        documentNumber: invoice.invoiceNumber,
        documentType,
        readinessStatus:
          readiness.readinessStatus,
        provider: result.provider,
        duplicate: false,
        submission: persistedResult,
        providerResult: result,
      };
    } catch (error) {
      const completedAt = new Date();

      const errorMessage =
        error instanceof Error
          ? error.message
          : 'Unknown ASP submission error';

      await this.prisma.$transaction([
        this.prisma.aspSubmissionAttempt.update({
          where: {
            id: attempt.id,
          },
          data: {
            status: 'UNKNOWN',
            errorCode:
              'ASP_RESPONSE_UNKNOWN',
            errorMessage,
            completedAt,
          },
        }),

        this.prisma.aspSubmission.update({
          where: {
            id: persistentSubmission.id,
          },
          data: {
            status: 'UNKNOWN',
            lastError: errorMessage,
            completedAt,
          },
        }),
      ]);

      throw new BadRequestException({
        message:
          'ASP submission outcome is unknown. Automatic retry is blocked pending reconciliation.',
        invoiceId,
        submissionId:
          persistentSubmission.id,
        status: 'UNKNOWN',
      });
    }
  }
}





