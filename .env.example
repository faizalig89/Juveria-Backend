# Juveria eInvoice Compliance Hub
# Example configuration only.
# NEVER place real production secrets in this file.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Replace with a strong secret in the real environment.
# Production requires at least 32 characters.
JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# Optional.
# Leave empty for ./uploads during local development.
# Production can point this to persistent mounted storage.
STORAGE_ROOT=

# Optional Java overrides.
# Normally Java is discovered automatically.
JAVA_EXECUTABLE=
JAVA_HOME=
# ASP provider selection.
# MOCK_ASP is for local development/testing.
# CYGNET and FLIK are recognized provider identifiers; real adapters require provider-specific configuration.
# Architecture supports adding additional ASP adapters without changing the core invoice workflow.
ASP_PROVIDER=MOCK_ASP

# Remote ASP connection.
# Required when ASP_PROVIDER is not MOCK_ASP.
# Replace values only in the real .env file. Never commit production credentials.
ASP_BASE_URL=https://asp.example.com
ASP_HTTP_TIMEOUT_MS=15000

# Optional authentication fields.
# Populate only those required by the selected ASP.
ASP_API_KEY=
ASP_CLIENT_ID=
ASP_CLIENT_SECRET=

MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
GOOGLE_CLIENT_ID=
